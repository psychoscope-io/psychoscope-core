[Unit]
Description=Psychoscope MODR - core (hub, supervisor e motor de deteccao)
Documentation=https://github.com/psychoscope-io/psychoscope-core
After=network.target
Wants=psychoscope-sensor.service

[Service]
Type=simple
User=psychoscope
Group=psychoscope
ExecStart=/usr/local/bin/psychoscope --config /etc/psychoscope/psychoscope.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# Diretorios gerenciados pelo systemd (dono: psychoscope). Com eles, o Core usa
# /run/psychoscope (sockets) e /var/lib/psychoscope (alerts.db) sem configuracao extra.
RuntimeDirectory=psychoscope
RuntimeDirectoryMode=0750
StateDirectory=psychoscope
StateDirectoryMode=0750
UMask=0077

# Privilegios minimos. O Core roda como usuario sem NENHUMA capability e com NoNewPrivileges.
# O sensor (que precisa de CAP_NET_RAW/CAP_NET_ADMIN) NAO e filho do Core: tem unit propria,
# usuario proprio e as capabilities por AmbientCapabilities (psychoscope-sensor.service). Assim
# o isolamento abaixo pode ser tao forte quanto o systemd permitir, sem depender de setcap.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Isolamento
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
